+ obs=observation();path=tmp_path/'checkpoint.json';harvest_native.save_checkpoint(path,obs)
+ assert len(calls)==2
+ raw=path.read_bytes();obs['metrics']['bad']=float('nan')
+ with pytest.raises(ValueError):harvest_native.save_checkpoint(path,obs)
