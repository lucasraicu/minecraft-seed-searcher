+            biome_points_by_feature[f['id']]=sorted(points)
+
+    ow_radii = tuple(active_registry.get('overworld_radii', (256, 512, 1024)))
+    nether_radii = tuple(active_registry.get('nether_radii', (64, 128, 256)))
